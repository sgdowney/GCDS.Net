@model WebAppMvc.Models.GcdsInputViewModel
<section>
    <gcds-heading tag="h1">@localizer["HeadingText"]</gcds-heading>
    <gcds-text>
        @localizer["PageText"]
    </gcds-text>
</section>
<section class="mt-300">
    <form method="post" id="inputForm" name="inputForm" novalidate>
        <gcds-error-summary heading="@sharedResource["ErrorSummaryHeading"]"></gcds-error-summary>
        <gcds-input gcds-for="EmailAddress" hint="@localizer["EmailAddressHint"].Value" form="inputForm" type="email"></gcds-input>
        <gcds-input gcds-for="Password" size="17" form="inputForm" type="password"></gcds-input>
        <gcds-input gcds-for="AgeOfEligibility" hint="@localizer["AgeHint"].Value" size="5" type="number" form="inputForm"></gcds-input>
        <gcds-input gcds-for="PrefilledField" hint="@localizer["PrefilledFieldHint"].Value" type="text" size="10" form="inputForm"></gcds-input>
        <gcds-button button-id="submitButton" value="Continue" type="submit">
            @localizer["ContinueButtonLabel"]
        </gcds-button>
    </form>
</section>

<!-- TODO: Update the date to reflect the page's most recent change. -->
<gcds-date-modified>2024-08-22</gcds-date-modified>
