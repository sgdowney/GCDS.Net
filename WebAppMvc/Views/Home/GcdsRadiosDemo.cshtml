        // new CheckboxRadioItemModel { Id = "LeastFavSummer", Label = localizer["SummerLabel"].Value, Hint = localizer["SummerHint"].Value, Value="Summer"},
        // new CheckboxRadioItemModel { Id = "LeastFavFall", Label = localizer["FallLabel"].Value, Hint = localizer["FallHint"].Value, Value = "Fall"}];
        //     List<ICheckboxRadioItemModel> favPreRadioItems = [new CheckboxRadioItemModel { Id = "FavPreWinter", Label = localizer["WinterLabel"].Value, Hint = localizer["WinterHint"].Value, Value = "Winter"},
        // new CheckboxRadioItemModel { Id = "FavPreSpring", Label = localizer["SpringLabel"].Value, Hint = localizer["SpringHint"].Value, Value="Spring"},
        // new CheckboxRadioItemModel { Id = "FavPreSummer", Label = localizer["SummerLabel"].Value, Hint = localizer["SummerHint"].Value, Value="Summer"},
        // new CheckboxRadioItemModel { Id = "FavPreFall", Label = localizer["FallLabel"].Value, Hint = localizer["FallHint"].Value, Value = "Fall"}];
        //     List<ICheckboxRadioItemModel> leastFavPreRadioItems = [new CheckboxRadioItemModel { Id = "LeastFavPreWinter", Label = localizer["WinterLabel"].Value, Hint = localizer["WinterHint"].Value, Value = "Winter"},
        // new CheckboxRadioItemModel { Id = "LeastFavPreSpring", Label = localizer["SpringLabel"].Value, Hint = localizer["SpringHint"].Value, Value="Spring"},
        // new CheckboxRadioItemModel { Id = "LeastFavPreSummer", Label = localizer["SummerLabel"].Value, Hint = localizer["SummerHint"].Value, Value="Summer"},
