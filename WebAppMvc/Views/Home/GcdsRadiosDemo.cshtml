        }
        <gcds-radios gcds-for="FavouriteSeason" options="@seasonRadioItems"></gcds-radios>
        <gcds-radios gcds-for="LeastFavouriteSeason" options="@seasonRadioItems"></gcds-radios>
        <gcds-radios gcds-for="FavouriteSeasonPreselected" options="@seasonRadioItems"></gcds-radios>
        <gcds-radios gcds-for="LeastFavouriteSeasonPreselected" options="@seasonRadioItems"></gcds-radios>
        <gcds-button button-id="submitButton" value="Continue" type="submit">
            @localizer["ContinueButtonLabel"]
        </gcds-button>
    </form>
</section>

